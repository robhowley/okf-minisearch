{
  "name": "okf-minisearch-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "package:check": "pnpm install --frozen-lockfile && pnpm build && pnpm -r typecheck && pnpm -r test && pnpm test:demo && node scripts/check-package.mjs",
    "test": "pnpm build && pnpm -r test && pnpm test:demo",
    "test:demo": "vitest run test/demo.test.ts",
    "typecheck": "pnpm build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@okf-internal/prepare": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.2.0",
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.2",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}